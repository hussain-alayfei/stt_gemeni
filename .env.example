# Required: Google AI Studio key, used only on the server.
GEMINI_API_KEY=your_google_ai_studio_key_here

# Required: the access code people type on the sign-in page. Use a long random value.
# Changing it signs everyone out.
ACCESS_CODE=choose_a_long_random_code

# Optional: token prices (USD per 1M tokens) for the cost estimates. Defaults: 2 and 12.
# GEMINI_INPUT_USD_PER_MILLION=2
# GEMINI_OUTPUT_USD_PER_MILLION=12

# On Vercel, add these in Project Settings > Environment Variables (mark the key and code as Sensitive).
